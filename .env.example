# ---- runtime mode ----
# memory: everything in one process (dev + tests, zero deps)
# redis:  separate microservices talking over Redis Streams/PubSub (prod-like)
IF_MODE=memory

# ---- service identity (only used in redis mode) ----
IF_SERVICE=gateway

# ---- data stores ----
# memory mode uses SQLite; redis/postgres mode uses these
DATABASE_URL=sqlite:///./data/inferfleet.db
REDIS_URL=redis://localhost:6379/0

# ---- queue / batching ----
IF_QUEUE_MAX=1000
IF_BATCH_SIZE=16
IF_BATCH_WAIT_MS=20
IF_JOB_TIMEOUT_S=30
IF_TTFB_BUDGET_MS=300

# ---- caching ----
IF_CACHE_TTL_S=900
IF_SEMANTIC_THRESHOLD=0.90

# ---- failure injection (for demos/tests) ----
IF_FAILURE_RATE=0.0
IF_AUTO_SEED=true
